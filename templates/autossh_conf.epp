[Unit]
Description=AutoSSH tunnel to <%= $remote_host %> for <%= $proxy_name %>
After=network-online.target

[Service]
User=root
ExecStart=/usr/bin/autossh -M <%= $monit_port %> -N -o "ServerAliveInterval 30" -o "ServerAliveCountMax 3" -o "StrictHostKeyChecking no" <%= $port_bindings %> autossh@<%= $remote_host %> -i <%= $identity_file %>
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
